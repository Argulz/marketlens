# Modèle de configuration locale. Copier en `.env` puis ajuster.
#   cp .env.template .env

STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:8000

# Postgres local — 5440 et non 5432, ce dernier étant pris par une autre pile
# sur la machine de développement. Voir docker-compose.yml à la racine.
DATABASE_URL=postgres://marketlens:marketlens@localhost:5440/marketlens
DB_NAME=marketlens

# Développement uniquement. medusa-config.ts échoue au démarrage si ces valeurs
# restent en place avec NODE_ENV=production : ce n'est pas un oubli à rattraper
# plus tard, c'est un garde-fou.
JWT_SECRET=dev-jwt-a-remplacer
COOKIE_SECRET=dev-cookie-a-remplacer

# Service de vision (FastAPI, dépôt services/vision).
# Le port est 8010 et non 8001 : 8001 à 8008 sont occupés sur la machine de
# développement par la pile d'un autre projet qui démarre avec Docker Desktop.
VISION_SERVICE_URL=http://localhost:8010

# Doit être IDENTIQUE au VISION_SERVICE_SECRET de services/vision/.env.
# S'ils divergent, le service de vision rend 401, Medusa le classe en panne
# amont et rend 503 — pas 400 : ce n'est pas la photo du marchand qui est en
# cause.
VISION_SERVICE_SECRET=dev-secret-partage-a-remplacer

# Délai maximum accordé au service de vision, en millisecondes.
# Défaut : 60000. Le service s'impose lui-même une échéance globale de 45 s et
# rend alors un 504 exploitable ; cette borne doit rester AU-DESSUS, sinon
# Medusa le coupe avant qu'il ait pu dire pourquoi il a échoué.
# Une valeur absente, vide ou non numérique retombe sur le défaut.
# VISION_REQUEST_TIMEOUT_MS=60000
